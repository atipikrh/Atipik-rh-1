# Copier vers .env.local et renseigner les valeurs (ne jamais committer de secrets)
# Documentation : README.md, CONFIGURATION_BREVO.md, PROTECTION-ANTI-SPAM.md

# --- Brevo (obligatoire en production Vercel) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@example.com
BREVO_RECIPIENT_EMAIL=contact@example.com

# --- reCAPTCHA v3 (paire obligatoire : les deux clés ou aucune) — contact, quiz ---
# Recommandé en production Vercel pour protéger /contact et /bilan-de-competences/quiz
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- reCAPTCHA v2 invisible (paire obligatoire) — inscriptions /s-inscrire ---
# Actif en production (vérifier dans les logs de build : recaptcha_v2=active)
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# --- Akismet (paire obligatoire : clé + URL ou aucune) ---
# Recommandé en production pour filtrer le spam sur tous les formulaires
AKISMET_API_KEY=
AKISMET_SITE_URL=https://www.atipikrh.com

# --- Google Search Console (optionnel — sync sitemaps via API) ---
# Vérification HTML (balise meta <head>)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Guide : docs/GSC_API_SETUP.md
# Option A (si compte de service « introuvable » dans GSC) : npm run seo:gsc-oauth-setup
# GSC_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GSC_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# Option B — compte de service
# GSC_SERVICE_ACCOUNT_JSON_PATH=secrets/gsc-service-account.json
# GSC_SERVICE_ACCOUNT_JSON=
# GSC_SITE_URL=sc-domain:atipikrh.com

# --- Google Ads (optionnel) — conversion après consentement marketing ---
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-0000000000
# NEXT_PUBLIC_GOOGLE_ADS_LABEL=xxxxxxxx
# GSC_AUTH=oauth
