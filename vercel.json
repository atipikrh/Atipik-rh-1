{
  "redirects": [
    {
      "source": "/:path+/",
      "has": [
        {
          "type": "host",
          "value": "atipikrh.com"
        }
      ],
      "destination": "https://www.atipikrh.com/:path+",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "atipikrh.com"
        }
      ],
      "destination": "https://www.atipikrh.com/$1",
      "permanent": true
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "npm run build"
}
